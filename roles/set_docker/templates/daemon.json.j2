{
  "log-driver": "{{ set_docker_log_driver }}",
  "log-opts": {
    "max-size": "{{ set_docker_log_max_size }}",
    "max-file": "{{ set_docker_log_max_file }}"
  },
  "storage-driver": "{{ set_docker_storage_driver }}",
  "default-address-pools": [
{% for pool in set_docker_default_address_pools %}
    {
      "base": "{{ pool.base }}",
      "size": {{ pool.size }}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ],
  "exec-opts": ["native.cgroupdriver=systemd"]
}