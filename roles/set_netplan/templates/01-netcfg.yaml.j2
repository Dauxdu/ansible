# {{ ansible_managed }}
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ set_netplan_config.interface }}:
      dhcp4: {{ set_netplan_config.dhcp | bool | to_json }}
{% if not set_netplan_config.dhcp | bool %}
      addresses:
        - {{ set_netplan_config.address }}/{{ set_netplan_config.prefix }}
      routes:
        - to: default
          via: {{ set_netplan_config.gateway }}
{% endif %}
{% if set_netplan_config.dns_servers | length > 0 %}
      nameservers:
        addresses: {{ set_netplan_config.dns_servers | to_json }}
{% endif %}
